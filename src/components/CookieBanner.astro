---
import { langFromPath, localePath } from "../i18n/ui";

const lang = langFromPath(Astro.url.pathname);
const pl = lang === "pl";
---

<div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-xl" role="dialog" aria-live="polite">
  <div class="rounded-lg border border-ink bg-paper p-5 shadow-[4px_4px_0_0_var(--ink)]">
    <p class="text-sm leading-relaxed">
      {pl
        ? "Strona zapamiętuje w przeglądarce tylko Twoje ustawienia (motyw, ten wybór). Nie śledzę Cię i nie sprzedaję danych."
        : "This site only stores your settings (theme, this choice) in your browser. No tracking, no selling data."}
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <button id="cookie-accept" class="rounded-full bg-ink px-4 py-2 text-sm text-paper hover:opacity-85">
        {pl ? "Akceptuję" : "Accept"}
      </button>
      <button id="cookie-reject" class="rounded-full border border-line px-4 py-2 text-sm hover:border-ink">
        {pl ? "Odrzucam" : "Reject"}
      </button>
      <a class="ml-auto text-xs text-muted underline-offset-2 hover:text-ink hover:underline" href={localePath(lang, "/cookies")}>
        {pl ? "Więcej" : "Details"}
      </a>
    </div>
  </div>
</div>

<script>
  const key = "cookie-consent";
  const banner = document.getElementById("cookie-banner");
  let seen: string | null = "unknown";
  try {
    seen = localStorage.getItem(key);
  } catch {}
  if (!seen) banner?.classList.remove("hidden");

  const close = (value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {}
    banner?.classList.add("hidden");
  };
  document.getElementById("cookie-accept")?.addEventListener("click", () => close("accepted"));
  document.getElementById("cookie-reject")?.addEventListener("click", () => close("rejected"));
</script>
