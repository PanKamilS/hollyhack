---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTabs from "../components/CategoryTabs.astro";
import PostItem from "../components/PostItem.astro";
import { t, type Lang } from "../i18n/ui";
import { getPosts } from "../lib/posts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await getPosts(lang);
---

<BaseLayout lang={lang}>
  <div class="mx-auto max-w-3xl px-4 pt-10 sm:px-6">
    <section class="border-b border-line pb-6">
      <p class="font-mono text-sm">
        {t(lang, "home.topics").split("|").join(" · ")}
      </p>
      <p class="mt-2 text-sm leading-relaxed text-muted">{t(lang, "home.lead")}</p>
    </section>

    <div class="mt-6">
      <CategoryTabs lang={lang} />
    </div>

    <section class="mt-2">
      {posts.length > 0 ? posts.map((post) => <PostItem post={post} />) : <p class="py-10 text-muted">{t(lang, "list.empty")}</p>}
    </section>
  </div>
</BaseLayout>
