---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy" lang="en">

  <article class="prose mx-auto max-w-3xl px-4 pt-10 sm:px-6 dark:prose-invert prose-h1:text-xl prose-h1:font-semibold">
    <h1>Privacy Policy</h1>

    <p>
      This website publishes technical articles and walkthroughs. I do not intentionally collect personal data unless you
      contact me directly.
    </p>

    <h2>Contact</h2>
    <p>
      If you contact me (e.g., via email), I will only use your message to respond.
    </p>

    <h2>Analytics</h2>
    <p>
      If analytics are enabled in the future, they will be used to understand traffic in aggregate.
    </p>

    <h2>Changes</h2>
    <p>
      This policy may be updated from time to time.
    </p>
  </article>
</BaseLayout>
