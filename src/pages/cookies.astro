---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Cookies" lang="en">

  <article class="prose mx-auto max-w-3xl px-4 pt-10 sm:px-6 dark:prose-invert prose-h1:text-xl prose-h1:font-semibold">
    <h1>Cookies</h1>

    <p>
      This site uses necessary cookies/storage to provide basic functionality (e.g., remembering your theme or consent choice).
    </p>

    <h2>Your choices</h2>
    <p>
      You can accept or reject optional cookies via the cookie banner. You can also clear your browser storage to reset your choice.
    </p>
  </article>
</BaseLayout>
