---
import ListView from "../../views/ListView.astro";
import { localePath, t } from "../../i18n/ui";
import { getPosts, postTags, tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts("en");
  const tags = new Map(posts.flatMap(postTags).map((tag) => [tagSlug(tag), tag]));
  return [...tags].map(([slug, tag]) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => postTags(p).some((x) => tagSlug(x) === slug)) },
  }));
}

const { tag, posts } = Astro.props;
---

<ListView lang="en" eyebrow={t("en", "tags.title")} title={tag} posts={posts} tabs={false} altHref={localePath("pl", "/tags")} />
